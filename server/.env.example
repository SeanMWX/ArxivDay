# Docker settings for server/docker-compose.yml.
# Copy this file to .env and fill in your own API settings before starting the server.

# Host port exposed by Docker. Visit http://localhost:8080 by default.
SERVER_HOST_PORT=8080

# Data API address used by the web server.
API_BASE_URL=http://host.docker.internal:8000

# Must match the [api] key in api/config.ini.
API_KEY=CHANGE_ME
