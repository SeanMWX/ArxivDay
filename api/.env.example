# Copy this file to .env, then fill in values for the existing external MySQL server.
# Do not use localhost for DB_HOST unless MySQL is running inside the same container.

# Host port exposed by Docker. Visit http://localhost:8000 by default.
API_HOST_PORT=8000

# Port the API listens on inside the container.
API_PORT=8000

# Must match the key used by server/app clients as the X-API-Key header.
API_KEY=CHANGE_ME

# Existing MySQL server settings. Docker will not create, migrate, or reset this database.
DB_HOST=YOUR_MYSQL_HOST_OR_IP
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=arxiv

# Existing article table and category list.
ARXIV_TABLE=arxiv_daily
CATEGORIES=cs.AI, cs.CR, cs.LG

# Stored on the api-sync-data Docker volume by default.
SYNC_DB_PATH=/data/sync.db
